SERVER_PORT=8082

DB_URL=jdbc:mysql://<prod-db-host>:3306/user_servicedb?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=<prod-db-user>
DB_PASSWORD=<prod-db-password>

JWT_SECRET=<prod-jwt-secret-min-32-bytes>
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=lexho-user-service
JWT_AUDIENCE=lexho-clients

ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@lexho.com
ADMIN_SEED_PASSWORD=<leave-empty-when-disabled>

APP_ALLOWED_CORS_ORIGINS=https://admin.example.com,https://app.example.com

APP_SECURITY_EXPOSE_SWAGGER=false
APP_SECURITY_ALLOW_INTERNAL_OPEN=false
APP_SECURITY_ALLOW_PUBLIC_CUSTOMER_READ=false
APP_SECURITY_ALLOW_PUBLIC_PROVIDER_ONBOARDING=false
APP_SECURITY_ALLOW_PUBLIC_ADMIN_PROFILE_CONTENT=false

INTERNAL_API_TOKEN=<prod-internal-api-token>
