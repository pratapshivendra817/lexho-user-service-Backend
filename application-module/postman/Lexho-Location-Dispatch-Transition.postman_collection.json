              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 22.7196,\n  \"longitude\": 75.8577,\n  \"serviceType\": \"COOK\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/location/serviceability/check"
          }
        }
      ]
    },
    {
