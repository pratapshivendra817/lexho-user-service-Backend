{
  "info": {
    "name": "Lexho Location + Dispatch Transition APIs",
    "_postman_id": "d7f8f76a-3e2a-47cb-a90b-lexho-location-dispatch-transition",
    "description": "Canonical and deprecated transition APIs for customer location and partner dispatch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is success (< 400)', function () {",
          "  pm.expect(pm.response.code).to.be.below(400);",
          "});",
          "",
          "pm.test('Response is valid JSON when body is present', function () {",
          "  const text = pm.response.text();",
          "  if (!text || !text.trim()) {",
          "    return;",
          "  }",
          "  pm.expect(function () { JSON.parse(text); }).to.not.throw();",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth Token Setup",
      "item": [
        {
          "name": "Send OTP Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{customerMobile}}\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": "{{baseUrl}}/otp/send"
          }
        },
        {
          "name": "Verify OTP Customer (Set customerToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) { res = {}; }",
                  "const token = (res.data && res.data.token) || res.token;",
                  "if (token) { pm.environment.set('customerToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{customerMobile}}\",\n  \"otp\": \"{{customerOtp}}\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": "{{baseUrl}}/otp/verify"
          }
        },
        {
          "name": "Send OTP Partner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{partnerMobile}}\",\n  \"role\": \"PARTNER\"\n}"
            },
            "url": "{{baseUrl}}/otp/send"
          }
        },
        {
          "name": "Verify OTP Partner (Set partnerToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) { res = {}; }",
                  "const token = (res.data && res.data.token) || res.token;",
                  "if (token) { pm.environment.set('partnerToken', token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{partnerMobile}}\",\n  \"otp\": \"{{partnerOtp}}\",\n  \"role\": \"PARTNER\"\n}"
            },
            "url": "{{baseUrl}}/otp/verify"
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "Admin Verify OTP (Set adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let res = {};",
                  "try { res = pm.response.json(); } catch (e) { res = {}; }",
                  "if (res && res.accessToken) { pm.environment.set('adminToken', res.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{adminOtp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/verify-otp"
          }
        }
      ]
    },
    {
      "name": "Customer Canonical",
      "item": [
        {
          "name": "Save Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"addressLine\": \"Flat 101, Rohini Sector 9\",\n  \"latitude\": 28.7333,\n  \"longitude\": 77.1333,\n  \"city\": \"Delhi\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/location/save-address"
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
