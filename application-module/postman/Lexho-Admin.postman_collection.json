{
  "info": {
    "name": "Lexho Admin APIs",
    "_postman_id": "7e34e350-3a56-41ef-a54e-lexho-admin-all",
    "description": "Complete admin dashboard API collection for Lexho backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedByRequest = {",
          "  'Verify OTP': [200, 400],",
          "  'Get Booking': [200, 404, 500],",
          "  'Update Verification': [200, 400, 404],",
          "  'Delete Review': [200, 404, 500],",
          "  'Flag Review': [200, 404, 500],",
          "  'Create Notification': [200, 400, 404],",
          "  'Update Ticket Status': [200, 404],",
          "  'Reply Ticket': [200, 404],",
          "  'Toggle User': [200, 404]",
          "};",
          "const strictMode = String(pm.environment.get('strictMode') || '').toLowerCase() === 'true';",
          "const allowed = expectedByRequest[pm.info.requestName] || [];",
          "pm.test('HTTP status is expected', function () {",
          "  if (strictMode) {",
          "    pm.expect(pm.response.code).to.be.below(400);",
          "    return;",
          "  }",
          "  if (allowed.length > 0) {",
          "    pm.expect(allowed).to.include(pm.response.code);",
          "    return;",
          "  }",
          "  pm.expect(pm.response.code).to.be.below(400);",
          "});",
          "",
          "pm.test('Response is valid JSON when body is present', function () {",
          "  const text = pm.response.text();",
          "  if (!text || !text.trim()) {",
          "    return;",
          "  }",
          "  pm.expect(function () { JSON.parse(text); }).to.not.throw();",
          "});"
        ]
      }
    }
  ],
