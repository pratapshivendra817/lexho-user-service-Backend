## Server
SERVER_PORT=8082

## Database (required)
DB_URL=jdbc:mysql://localhost:3306/user_servicedb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

## JWT (required, min 32 bytes recommended)
JWT_SECRET=replace-with-a-unique-strong-secret-minimum-32-characters
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=lexho-user-service
JWT_AUDIENCE=lexho-clients

## Admin seed (required if ADMIN_SEED_ENABLED=true)
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@lexho.com
ADMIN_SEED_PASSWORD=replace-with-a-unique-admin-seed-password

## Redis (optional for local; Partner dispatch needs Redis GEO commands, Redis 3.2+)
REDIS_HOST=localhost
REDIS_PORT=6380
IT_REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

## Mail (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

## App
APP_UPLOAD_BASE_DIR=uploads
APP_BOOKING_SERVICE_URL=http://localhost:8082
APP_ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

## Razorpay payment gateway (required for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

## Security exposure toggles
APP_SECURITY_EXPOSE_SWAGGER=false
APP_SECURITY_ALLOW_INTERNAL_OPEN=false
APP_SECURITY_ALLOW_PUBLIC_CUSTOMER_READ=false
APP_SECURITY_ALLOW_PUBLIC_PROVIDER_ONBOARDING=false
APP_SECURITY_ALLOW_PUBLIC_ADMIN_PROFILE_CONTENT=false

## Legacy API deprecation toggles (Phase 5 rollout)
APP_API_LEGACY_CUSTOMER_LOCATION_ENABLED=true
APP_API_LEGACY_PARTNER_SHIFT_ENABLED=true
APP_API_LEGACY_ADDRESS_MODULE_ENABLED=true

## Required only when APP_SECURITY_ALLOW_INTERNAL_OPEN=false
INTERNAL_API_TOKEN=change-me
