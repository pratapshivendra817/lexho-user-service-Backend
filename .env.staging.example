SERVER_PORT=8082

DB_URL=jdbc:mysql://<staging-db-host>:3306/user_servicedb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=<staging-db-user>
DB_PASSWORD=<staging-db-password>

JWT_SECRET=<staging-jwt-secret-min-32-bytes>
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=lexho-user-service
JWT_AUDIENCE=lexho-clients

ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@lexho.com
ADMIN_SEED_PASSWORD=<staging-admin-seed-password>

APP_ALLOWED_CORS_ORIGINS=https://staging-admin.example.com,https://staging-app.example.com

APP_SECURITY_EXPOSE_SWAGGER=false
APP_SECURITY_ALLOW_INTERNAL_OPEN=false
APP_SECURITY_ALLOW_PUBLIC_CUSTOMER_READ=true
APP_SECURITY_ALLOW_PUBLIC_PROVIDER_ONBOARDING=false
APP_SECURITY_ALLOW_PUBLIC_ADMIN_PROFILE_CONTENT=false

INTERNAL_API_TOKEN=<staging-internal-api-token>
