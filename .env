## Server
SERVER_PORT=8082

## Database (required)
DB_URL=jdbc:mysql://localhost:3306/user_servicedb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=Muskaan@8756

## JWT (required, min 32 bytes recommended)
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-bytes
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=lexho-user-service
JWT_AUDIENCE=lexho-clients

## Admin seed (required if ADMIN_SEED_ENABLED=true)
ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@lexho.com
ADMIN_SEED_PASSWORD=Admin@12345!

## Redis (optional for local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

## Mail (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

## App
APP_UPLOAD_BASE_DIR=uploads
APP_BOOKING_SERVICE_URL=http://localhost:8082
APP_ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
APP_PUSH_FCM_ENABLED=true
APP_PUSH_FCM_SERVICE_ACCOUNT_PATH=C:\\Users\\shivendra\\Downloads\\lexho-customer-firebase-adminsdk-fbsvc-721f2fa843.json

## Security exposure toggles (dev-friendly defaults)
APP_SECURITY_EXPOSE_SWAGGER=true
APP_SECURITY_ALLOW_INTERNAL_OPEN=true
APP_SECURITY_ALLOW_PUBLIC_CUSTOMER_READ=true
APP_SECURITY_ALLOW_PUBLIC_PROVIDER_ONBOARDING=true
APP_SECURITY_ALLOW_PUBLIC_ADMIN_PROFILE_CONTENT=true

## Required only when APP_SECURITY_ALLOW_INTERNAL_OPEN=false
INTERNAL_API_TOKEN=LexhoInternal@2026#Admin
